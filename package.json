{
  "name": "dashboard-of-dpi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-unbounded-queries.js && node scripts/check-working-calendar.js && node scripts/check-positive-junk.js && node scripts/check-call-quality.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:unbounded-queries": "node scripts/check-unbounded-queries.js",
    "check:working-calendar": "node scripts/check-working-calendar.js",
    "check:working-calendar-parity": "node --env-file=.env.local scripts/check-working-calendar-parity.mjs",
    "check:positive-junk": "node scripts/check-positive-junk.js",
    "check:call-quality": "node scripts/check-call-quality.js",
    "check:recycle-deploy": "node scripts/check-recycle-deploy.js",
    "deploy:recycle": "node scripts/check-recycle-deploy.js && npx supabase functions deploy recycle-stale-leads --use-api"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/papaparse": "^5.5.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "next": "16.2.4",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
